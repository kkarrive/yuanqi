# 服务入站鉴权：飞书自动化请求头需带 Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-please

# Comfy Cloud
COMFY_BASE_URL=https://cloud.comfy.org
COMFY_API_KEY=comfyui-xxxxxxxx
COMFY_USAGE_SOURCE=feishu-poster-demo

# 飞书自建应用
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# 多维表格定位：app_token 是多维表格 URL 里 /base/<这段>
FEISHU_APP_TOKEN=bascnxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxx

# 字段名（必须和多维表格里的列名完全一致）
FIELD_PRODUCT_IMAGE=产品图
FIELD_REQUIREMENT=需求描述
FIELD_STYLE=风格
FIELD_STATUS=状态
FIELD_RESULT=结果图
FIELD_ERROR=错误信息
FIELD_CREATOR=提交人

# 状态选项值（必须和单选字段的选项文案一致）
STATUS_PENDING=待处理
STATUS_DOING=生成中
STATUS_DONE=已完成
STATUS_FAILED=失败

# 一次任务出几张候选（Comfy Cloud 每次调用计费，默认 1 张）
MAX_CANDIDATES=1

# 同一 record 的去重窗口（秒）
DEDUP_TTL_S=3600
