# 服务入站鉴权：飞书自动化请求头需带 Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-please

# Comfy Cloud
COMFY_BASE_URL=https://cloud.comfy.org
COMFY_API_KEY=comfyui-xxxxxxxx
COMFY_USAGE_SOURCE=feishu-poster-demo

# 新版元气森林九宫格工作流（相对路径从仓库根目录解析）
WORKFLOW_PATH=yuanqi-poster-workflow.json
# 回写的输出节点：68=九宫格整图，59..67=按序九张切片，81=单格放大图
WORKFLOW_OUTPUT_NODES=68,59,60,61,62,64,63,65,66,67,81
WORKFLOW_IMAGE_NODE=11
WORKFLOW_ACTIVITY_NODE=3761723474387808
WORKFLOW_SCHEME_NODE=2565934293372055
WORKFLOW_CARD_NODE=2334937224229421
WORKFLOW_PROMPT_NODE=1705779279442278

# 飞书自建应用
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# 多维表格定位：app_token 是多维表格 URL 里 /base/<这段>
FEISHU_APP_TOKEN=bascnxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxx

# 字段名（必须和多维表格里的列名完全一致）
FIELD_PRODUCT_IMAGE=产品图
FIELD_REQUIREMENT=需求描述
FIELD_STYLE=风格
FIELD_SCHEME=方案
FIELD_PRODUCT_CARD=产品卡片
FIELD_STATUS=状态
FIELD_RESULT=结果图
# 三类产出分别落到三个附件字段
FIELD_TILES=九宫格切片
FIELD_UPSCALED=放大图
FIELD_ERROR=错误信息
FIELD_CREATOR=提交人

# 状态选项值（必须和单选字段的选项文案一致）
STATUS_PENDING=待处理
STATUS_DOING=生成中
STATUS_DONE=已完成
STATUS_FAILED=失败

# 同一 record 的去重窗口（秒）
DEDUP_TTL_S=3600

# 轮询模式：true 时服务主动扫描「待处理」记录
POLL_ENABLED=true
POLL_INTERVAL_S=10
